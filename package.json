{
  "name": "claude-mcp-for-codex",
  "version": "0.1.0",
  "description": "Ask Claude Code from Codex through a local stdio MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin", "linux"],
  "bin": {
    "claude-mcp-for-codex": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
